# Copy to .env and fill in locally. NEVER commit real values.

# --- Database (Neon in phase 1, self-hosted Postgres in phase 2) -------------
# Use the POOLED connection string on Neon: the daily cron always hits a cold compute.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Object storage (Cloudflare R2 in phase 1, OVH Object Storage in phase 2) -
# Only these four variables may differ between providers. Everything else is S3.
S3_ENDPOINT_URL=https://<account_id>.eu.r2.cloudflarestorage.com
S3_BUCKET=aoe2-stats-replays
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:5173

# Shared secret required by the cron endpoint. Requests without it are rejected.
CRON_SECRET=

# --- Steam ------------------------------------------------------------------
# OpenID 2.0 needs no API key, but the Steam Web API key enriches avatars/personas.
STEAM_API_KEY=

# --- Ingestion tuning -------------------------------------------------------
# Retention measured at ~31 days; we never let a capture get closer than this.
CAPTURE_BUDGET_DAYS=21
# Politeness toward an endpoint with undocumented rate limits.
AOEMS_MAX_REQUESTS_PER_SECOND=1
INGEST_RUN_BUDGET_SECONDS=240
