# Copy to .env and fill in locally. NEVER commit real values.

# --- Database (Neon in phase 1, self-hosted Postgres in phase 2) -------------
# Use the POOLED connection string on Neon: the daily cron always hits a cold compute.
# Must keep the `postgresql+psycopg://` scheme shown below (Settings enforces this):
# Neon's own connection-string page hands out the plain `postgresql://` scheme, which
# selects the wrong SQLAlchemy dialect.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
#
# Alembic (`infra/migrations`) reads this exact same variable and no other — but DDL needs
# Neon's DIRECT (unpooled) endpoint, not the pooled one above: the pooler runs in transaction
# mode, which does not give a migration the session semantics it needs. Neon's console tells
# the two apart by hostname — pooled carries a `-pooler` segment, direct does not, same scheme,
# everything else unchanged:
#   DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.<region>.aws.neon.tech/dbname?sslmode=require
# Never set the deployment target's DATABASE_URL to this value — that is the pooled string every
# request needs. Export the direct one only in the shell that runs `alembic upgrade head`, per
# the one procedure this has: docs/runbooks/database-migrations.md.

# --- Object storage (Cloudflare R2 in phase 1, OVH Object Storage in phase 2) -
# Only these four variables may differ between providers. Everything else is S3.
# S3_ENDPOINT_URL is the account host only — no bucket path, query or fragment
# (Settings enforces this). Cloudflare's bucket page displays an S3 API value that
# *includes* the bucket path; do not paste that value here, it belongs in S3_BUCKET.
S3_ENDPOINT_URL=https://<account_id>.eu.r2.cloudflarestorage.com
S3_BUCKET=aoe2-stats-replays
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=
# No trailing slash (Settings enforces this): Steam's OpenID callback compares this
# value byte-for-byte against `return_to`, so a stray `/` fails every sign-in.
PUBLIC_BASE_URL=http://localhost:5173

# Shared secret required by the cron endpoint. Requests without it are rejected.
# Minimum 32 characters (Settings enforces this): a value shorter than that, including an
# empty one, fails validation at startup instead of silently authenticating an empty
# "Bearer " header. Generate with e.g. `openssl rand -hex 32`.
CRON_SECRET=

# --- Steam ------------------------------------------------------------------
# OpenID 2.0 needs no API key, but the Steam Web API key enriches avatars/personas.
STEAM_API_KEY=

# --- Closed beta -------------------------------------------------------------
# Comma-separated Steam ids admitted to the closed beta. A first sign-in by a
# listed id stamps allowlisted_at; without an entry here nobody can be admitted.
BETA_ALLOWLIST_STEAM_IDS=

# --- Ingestion tuning -------------------------------------------------------
# The source's retention window is measured in docs/data-sources.md and is not restated here
# (constitution I 4.1.0). That window is contradicted as of 2026-08-28 and unresolved; this
# budget is conservative under either reading. It may be lowered at any time; raising it
# requires docs/data-sources.md to record the question as settled.
CAPTURE_BUDGET_DAYS=21
# A replay is not always published the instant a match ends, and the source
# answers an identical 404 for "not yet" and "never". Inside this window a 404
# is silence, not absence: the capture stays pending.
# DERIVED from the discovery cadence, not from the publication delay: at least twice
# the ~25 h cadence, so two polls always land inside the grace and one unlucky 404
# can never close a capture on its own. The publication delay itself is observed at
# minutes, not hours (docs/data-sources.md, n=1) — T012a turns that into a
# distribution, and this rises only if a sample ever exceeds the floor. Capture
# classification also requires two attempts before `unavailable`.
# This line is the only home for this number (T012b): scripts/checks/publication_delay.py
# parses it straight from this file at import time instead of holding its own copy, so
# raising the grace here is the one edit that changes what the nightly comparison and the
# generated docs/data-sources.md prose both use — nothing else may hard-code `72`.
REPLAY_PUBLICATION_GRACE_HOURS=72
# A safety ceiling, not a target. The real rate is bounded by the download itself —
# a replay is a few megabytes fetched in full, seconds each, so a run sits far below
# this figure and the bucket never binds. It is set where it is so that a future
# change (faster transfers, any parallelism) hits a limit we chose rather than one
# the source chooses for us: throttling stops the entire run, by design (FR-021).
# The only throttling evidence measured on this endpoint is in docs/data-sources.md
# and covers a much lower rate than this ceiling, so treat the ceiling as untested.
AOEMS_MAX_REQUESTS_PER_SECOND=1
INGEST_RUN_BUDGET_SECONDS=240
# Fairness between users within one run. Not politeness: that is AOEMS_MAX_REQUESTS_PER_SECOND.
INGEST_MAX_CAPTURES_PER_USER_PER_RUN=20
# Captures nearer than this to their deadline ignore the fairness cap entirely.
INGEST_QUOTA_EXEMPT_DAYS=7

# --- Search, favourites and analysis tuning ----------------------------------
# FR-016's bound: how many players a user may favourite. Rendering the list
# reads each entry's current standing, so an unbounded list is an unbounded
# query against the search/profile path on every page load. Product choice
# for the closed beta, not a measurement: generous enough that favouriting
# every player someone genuinely follows never bites, low enough that the
# list stays one bounded read.
FAVOURITES_MAX_PER_USER=100

# FR-004e: how long a search result stays in profile_search_cache before it
# is treated as stale and re-fetched. Ratings and standings drift slowly
# enough that a few minutes never shows a materially wrong rank, and short
# enough that a player who just climbed is findable again quickly. Product
# choice, not a measurement.
PLAYER_SEARCH_CACHE_TTL_SECONDS=300

# FR-005: per-user search rate limit, so search cannot be used to enumerate
# the source at volume through this service. A repeated query inside the TTL
# above is served from cache and never reaches this limit at all, so this
# bounds the rate of *distinct* queries. Product choice, sized generously
# above what typing a handful of names in a row produces.
PLAYER_SEARCH_MAX_PER_USER_PER_MINUTE=20

# FR-028: per-user rate limit on recorded-game requests — the caller's own
# archived replay and a third party's point of view fetched from the source.
# Not retained recordings: those are never served to anyone, only read by
# apps/analyzer (R8). Each request moves a multi-megabyte file
# rather than a page of JSON, so this sits well below the search limit
# above. Product choice, not a measurement.
REPLAY_DOWNLOAD_MAX_PER_USER_PER_MINUTE=6

# FR-040: per-user daily rate limit on analysis requests, so the CTA cannot
# be used to drive volume at the replay source through this service.
# Analysis is the most expensive action a user can trigger here — R3's
# memory-bound parse, and for a third-party match, a retained recording — so
# this stays low. Product choice, not a measurement.
ANALYSIS_MAX_REQUESTS_PER_USER_PER_DAY=10

# R7's budget gate: analysis's own daily allowance of requests to the replay
# source, kept below capture's. Capture's own ceiling under the current
# tuning is one run's worth of requests — INGEST_RUN_BUDGET_SECONDS (240) at
# AOEMS_MAX_REQUESTS_PER_SECOND (1), so at most 240 in its one daily run.
# This stays well under that so analysis can never account for a majority of
# one day's traffic to the source. Product choice, not a measurement.
ANALYSIS_MAX_SOURCE_REQUESTS_PER_DAY=60

# FR-047's total retention cap, in bytes, for recordings retained under
# constitution IX's on-demand analysis basis. Set below the free allowance
# so capture always has headroom it never has to compete for: Cloudflare R2's
# free tier is 10 GB (docs/adr/0002-hosting.md), and this reserves the large
# majority of it for capture's own archive. 2 GiB = 2 * 1024^3. Product
# choice, not a measurement.
ANALYSIS_RETENTION_CAP_BYTES=2147483648

# The interruptible unit of analysis work, as INGEST_RUN_BUDGET_SECONDS is
# for ingestion (R6). `api/analyze.py` runs at `maxDuration: 300`
# (docs/adr/0002-hosting.md); this leaves the same 60 s buffer under that
# ceiling that INGEST_RUN_BUDGET_SECONDS leaves under its own 300 s function,
# so a run always has time to record its own state before Vercel kills it.
ANALYSIS_RUN_BUDGET_SECONDS=240

# How long an analysis claim survives an invocation that died, in seconds
# (R6). Set to the platform's own `maxDuration` ceiling for `api/analyze.py`
# (docs/adr/0002-hosting.md): past that many seconds the invocation is
# provably dead rather than merely probably, so a lease this long is never
# reclaimed while the original request might still be working.
ANALYSIS_LEASE_SECONDS=300

# R3's memory bound: the raw recording size, in bytes, above which a
# recording is refused before it is parsed. Derived, not restated — see R3's
# "The number that follows" for the measured amplification behind this
# figure. 24 MiB = 24 * 1024 * 1024.
ANALYSIS_MAX_RAW_BYTES=25165824
