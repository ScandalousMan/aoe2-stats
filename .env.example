# Copy to .env and fill in locally. NEVER commit real values.

# --- Database (Neon in phase 1, self-hosted Postgres in phase 2) -------------
# Use the POOLED connection string on Neon: the daily cron always hits a cold compute.
# Must keep the `postgresql+psycopg://` scheme shown below (Settings enforces this):
# Neon's own connection-string page hands out the plain `postgresql://` scheme, which
# selects the wrong SQLAlchemy dialect.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Object storage (Cloudflare R2 in phase 1, OVH Object Storage in phase 2) -
# Only these four variables may differ between providers. Everything else is S3.
# S3_ENDPOINT_URL is the account host only — no bucket path, query or fragment
# (Settings enforces this). Cloudflare's bucket page displays an S3 API value that
# *includes* the bucket path; do not paste that value here, it belongs in S3_BUCKET.
S3_ENDPOINT_URL=https://<account_id>.eu.r2.cloudflarestorage.com
S3_BUCKET=aoe2-stats-replays
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=
# No trailing slash (Settings enforces this): Steam's OpenID callback compares this
# value byte-for-byte against `return_to`, so a stray `/` fails every sign-in.
PUBLIC_BASE_URL=http://localhost:5173

# Shared secret required by the cron endpoint. Requests without it are rejected.
# Minimum 32 characters (Settings enforces this): a value shorter than that, including an
# empty one, fails validation at startup instead of silently authenticating an empty
# "Bearer " header. Generate with e.g. `openssl rand -hex 32`.
CRON_SECRET=

# --- Steam ------------------------------------------------------------------
# OpenID 2.0 needs no API key, but the Steam Web API key enriches avatars/personas.
STEAM_API_KEY=

# --- Closed beta -------------------------------------------------------------
# Comma-separated Steam ids admitted to the closed beta. A first sign-in by a
# listed id stamps allowlisted_at; without an entry here nobody can be admitted.
BETA_ALLOWLIST_STEAM_IDS=

# --- Ingestion tuning -------------------------------------------------------
# Retention measured at ~31 days; we never let a capture get closer than this.
CAPTURE_BUDGET_DAYS=21
# A replay is not always published the instant a match ends, and the source
# answers an identical 404 for "not yet" and "never". Inside this window a 404
# is silence, not absence: the capture stays pending.
# DERIVED from the discovery cadence, not from the publication delay: at least twice
# the ~25 h cadence, so two polls always land inside the grace and one unlucky 404
# can never close a capture on its own. The publication delay itself is observed at
# minutes, not hours (docs/data-sources.md, n=1) — T012a turns that into a
# distribution, and this rises only if a sample ever exceeds the floor. Capture
# classification also requires two attempts before `unavailable`.
# This line is the only home for this number (T012b): scripts/checks/publication_delay.py
# parses it straight from this file at import time instead of holding its own copy, so
# raising the grace here is the one edit that changes what the nightly comparison and the
# generated docs/data-sources.md prose both use — nothing else may hard-code `72`.
REPLAY_PUBLICATION_GRACE_HOURS=72
# A safety ceiling, not a target. The real rate is bounded by the download itself —
# a replay is a few megabytes fetched in full, seconds each, so a run sits far below
# this figure and the bucket never binds. It is set where it is so that a future
# change (faster transfers, any parallelism) hits a limit we chose rather than one
# the source chooses for us: throttling stops the entire run, by design (FR-021).
# The only throttling evidence measured on this endpoint is in docs/data-sources.md
# and covers a much lower rate than this ceiling, so treat the ceiling as untested.
AOEMS_MAX_REQUESTS_PER_SECOND=1
INGEST_RUN_BUDGET_SECONDS=240
# Fairness between users within one run. Not politeness: that is AOEMS_MAX_REQUESTS_PER_SECOND.
INGEST_MAX_CAPTURES_PER_USER_PER_RUN=20
# Captures nearer than this to their deadline ignore the fairness cap entirely.
INGEST_QUOTA_EXEMPT_DAYS=7
