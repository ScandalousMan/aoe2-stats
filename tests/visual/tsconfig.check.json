{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../../scripts/visual/*.d.mts",
    "../../scripts/visual/*.d.cts"
  ]
}
