{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "buildCommand": "node scripts/checks/config-preflight.mjs && pnpm --filter web build",
  "outputDirectory": "apps/web/dist",
  "ignoreCommand": "node scripts/deploy/ignore-build.mjs",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/cron/ingest.py": {
      "maxDuration": 300,
      "excludeFiles": "{.env.example,.gitleaks.toml,.prettierrc.json,.tool-versions,.vercelignore,CLAUDE.md,README.md,alembic.ini,apps/**,infra/**,package.json,packages/**,playwright.config.ts,pnpm-workspace.yaml,scripts/**,tests/**,vercel.json}"
    },
    "api/analyze.py": {
      "maxDuration": 300,
      "excludeFiles": "{.env.example,.gitleaks.toml,.prettierrc.json,.tool-versions,.vercelignore,CLAUDE.md,README.md,alembic.ini,apps/**,infra/**,package.json,packages/**,playwright.config.ts,pnpm-workspace.yaml,scripts/**,tests/**,vercel.json}"
    },
    "api/index.py": {
      "maxDuration": 10,
      "excludeFiles": "{.env.example,.gitleaks.toml,.prettierrc.json,.tool-versions,.vercelignore,CLAUDE.md,README.md,alembic.ini,apps/**,infra/**,package.json,packages/**,playwright.config.ts,pnpm-workspace.yaml,scripts/**,tests/**,vercel.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
