{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "buildCommand": "pnpm --filter web build",
  "outputDirectory": "apps/web/dist",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/cron/ingest.py": {
      "maxDuration": 300
    },
    "api/index.py": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
